<?xml version="1.0"?>
<robot name="lemniscate_gates">
  <material name="neon_orange"><color rgba="1.0 0.35 0.05 1.0"/></material>
  <material name="electric_blue"><color rgba="0.05 0.50 1.0 1.0"/></material>
  <material name="gate_frame"><color rgba="0.22 0.24 0.26 1.0"/></material>
  <material name="marker_silver"><color rgba="0.95 0.95 0.98 1.0"/></material>
  <material name="badge_gold"><color rgba="1.0 0.85 0.1 1.0"/></material>

  <link name="world_gates_root">
    <inertial><mass value="0"/><origin xyz="0 0 0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>

  <!-- GATE 1 (East Outbound: pos=[3.5, 1.55, 0.75], yaw=0.0 deg) -->
  <link name="gate_1">
    <inertial><mass value="0"/><origin xyz="0 0 0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <!-- Left Upright Post -->
    <visual><origin xyz="0 -0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Right Upright Post -->
    <visual><origin xyz="0 0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Horizontal Lintel Crossbar -->
    <visual><origin xyz="0 0 0.962" rpy="1.5707 0 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Fabric Banner -->
    <visual><origin xyz="0 0 0.862"/><geometry><box size="0.015 1.524 0.20"/></geometry><material name="neon_orange"/></visual>
    <!-- Left Fabric Banner -->
    <visual><origin xyz="0 -0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="neon_orange"/></visual>
    <!-- Right Fabric Banner -->
    <visual><origin xyz="0 0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="neon_orange"/></visual>
    <!-- 4 Corner MoCap Markers -->
    <visual><origin xyz="0 -0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 -0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <!-- Gate ID Badge Box -->
    <visual><origin xyz="0 0 1.08"/><geometry><box size="0.02 0.35 0.12"/></geometry><material name="badge_gold"/></visual>
  </link>
  <joint name="joint_gate_1" type="fixed">
    <parent link="world_gates_root"/>
    <child link="gate_1"/>
    <origin xyz="3.5 1.55 0.75" rpy="0 0 0.0"/>
  </joint>

  <!-- GATE 2 (East Inbound: pos=[3.5, -1.60, 0.75], yaw=180.0 deg) -->
  <link name="gate_2">
    <inertial><mass value="0"/><origin xyz="0 0 0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <!-- Left Upright Post -->
    <visual><origin xyz="0 -0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Right Upright Post -->
    <visual><origin xyz="0 0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Horizontal Lintel Crossbar -->
    <visual><origin xyz="0 0 0.962" rpy="1.5707 0 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Fabric Banner -->
    <visual><origin xyz="0 0 0.862"/><geometry><box size="0.015 1.524 0.20"/></geometry><material name="electric_blue"/></visual>
    <!-- Left Fabric Banner -->
    <visual><origin xyz="0 -0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="electric_blue"/></visual>
    <!-- Right Fabric Banner -->
    <visual><origin xyz="0 0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="electric_blue"/></visual>
    <!-- 4 Corner MoCap Markers -->
    <visual><origin xyz="0 -0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 -0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <!-- Gate ID Badge Box -->
    <visual><origin xyz="0 0 1.08"/><geometry><box size="0.02 0.35 0.12"/></geometry><material name="badge_gold"/></visual>
  </link>
  <joint name="joint_gate_2" type="fixed">
    <parent link="world_gates_root"/>
    <child link="gate_2"/>
    <origin xyz="3.5 -1.60 0.75" rpy="0 0 3.14159"/>
  </joint>

  <!-- GATE 3 (West Inbound: pos=[-3.5, 1.50, 0.75], yaw=180.0 deg) -->
  <link name="gate_3">
    <inertial><mass value="0"/><origin xyz="0 0 0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <!-- Left Upright Post -->
    <visual><origin xyz="0 -0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Right Upright Post -->
    <visual><origin xyz="0 0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Horizontal Lintel Crossbar -->
    <visual><origin xyz="0 0 0.962" rpy="1.5707 0 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Fabric Banner -->
    <visual><origin xyz="0 0 0.862"/><geometry><box size="0.015 1.524 0.20"/></geometry><material name="neon_orange"/></visual>
    <!-- Left Fabric Banner -->
    <visual><origin xyz="0 -0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="neon_orange"/></visual>
    <!-- Right Fabric Banner -->
    <visual><origin xyz="0 0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="neon_orange"/></visual>
    <!-- 4 Corner MoCap Markers -->
    <visual><origin xyz="0 -0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 -0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <!-- Gate ID Badge Box -->
    <visual><origin xyz="0 0 1.08"/><geometry><box size="0.02 0.35 0.12"/></geometry><material name="badge_gold"/></visual>
  </link>
  <joint name="joint_gate_3" type="fixed">
    <parent link="world_gates_root"/>
    <child link="gate_3"/>
    <origin xyz="-3.5 1.50 0.75" rpy="0 0 3.14159"/>
  </joint>

  <!-- GATE 4 (West Outbound: pos=[-3.5, -1.70, 0.75], yaw=0.0 deg) -->
  <link name="gate_4">
    <inertial><mass value="0"/><origin xyz="0 0 0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <!-- Left Upright Post -->
    <visual><origin xyz="0 -0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Right Upright Post -->
    <visual><origin xyz="0 0.797 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Horizontal Lintel Crossbar -->
    <visual><origin xyz="0 0 0.962" rpy="1.5707 0 0"/><geometry><cylinder radius="0.035" length="1.924"/></geometry><material name="gate_frame"/></visual>
    <!-- Top Fabric Banner -->
    <visual><origin xyz="0 0 0.862"/><geometry><box size="0.015 1.524 0.20"/></geometry><material name="electric_blue"/></visual>
    <!-- Left Fabric Banner -->
    <visual><origin xyz="0 -0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="electric_blue"/></visual>
    <!-- Right Fabric Banner -->
    <visual><origin xyz="0 0.862 0"/><geometry><box size="0.015 0.20 1.524"/></geometry><material name="electric_blue"/></visual>
    <!-- 4 Corner MoCap Markers -->
    <visual><origin xyz="0 -0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 -0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <visual><origin xyz="0 -0.762 0.762"/><geometry><sphere radius="0.028"/></geometry><material name="marker_silver"/></visual>
    <!-- Gate ID Badge Box -->
    <visual><origin xyz="0 0 1.08"/><geometry><box size="0.02 0.35 0.12"/></geometry><material name="badge_gold"/></visual>
  </link>
  <joint name="joint_gate_4" type="fixed">
    <parent link="world_gates_root"/>
    <child link="gate_4"/>
    <origin xyz="-3.5 -1.70 0.75" rpy="0 0 0.0"/>
  </joint>
</robot>
