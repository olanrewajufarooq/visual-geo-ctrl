<?xml version="1.0"?>
<robot name="pybullet_drone">
  <!-- Realistic Material Palette -->
  <material name="dark_carbon"><color rgba="0.12 0.12 0.14 1.0"/></material>
  <material name="matte_carbon"><color rgba="0.18 0.18 0.20 1.0"/></material>
  <material name="cnc_aluminum"><color rgba="0.55 0.58 0.62 1.0"/></material>
  <material name="prop_front"><color rgba="0.0 0.90 0.35 0.65"/></material>
  <material name="prop_rear"><color rgba="1.0 0.30 0.05 0.65"/></material>
  <material name="led_green"><color rgba="0.0 1.0 0.2 1.0"/></material>
  <material name="led_red"><color rgba="1.0 0.05 0.05 1.0"/></material>
  <material name="led_cyan"><color rgba="0.0 0.9 1.0 1.0"/></material>
  <material name="led_amber"><color rgba="1.0 0.7 0.0 1.0"/></material>

  <link name="base_link">
    <!-- Mathematical Invariance: Exact Inertia from Paper System Identification -->
    <inertial>
      <mass value="3.646000"/>
      <origin xyz="0.000000 0.000000 -0.002290"/>
      <inertia ixx="4.090088e-02" ixy="5.656000e-05" ixz="1.313000e-05"
               iyy="4.015088e-02" iyz="-6.494000e-05" izz="6.921000e-02"/>
    </inertial>

    <!-- Authentic gym-pybullet-drones cf2.dae visual mesh -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="C:/Users/g202404900/Desktop/visual-geo-ctrl/assets/drone/cf2.dae" scale="3.5 3.5 3.5"/>
      </geometry>
    </visual>

    <!-- Physical Collision Geometry -->
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.25" length="0.08"/></geometry>
    </collision>
  </link>

  <!-- Motor 1 -->
  <link name="motor_1">
    <inertial>
      <mass value="1e-7"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <!-- CNC Aluminum Motor Stator -->
    <visual>
      <origin xyz="0.14000 0.14000 0.012"/>
      <geometry><cylinder radius="0.020" length="0.015"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Prop Locknut -->
    <visual>
      <origin xyz="0.14000 0.14000 0.024"/>
      <geometry><cylinder radius="0.007" length="0.009"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Aerodynamic Propeller Blur Disc -->
    <visual>
      <origin xyz="0.14000 0.14000 0.027"/>
      <geometry><cylinder radius="0.10" length="0.003"/></geometry>
      <material name="prop_front"/>
    </visual>
    <!-- Spinning Propeller Blades Silhouette -->
    <visual>
      <origin xyz="0.14000 0.14000 0.028" rpy="0 0 0.7850"/>
      <geometry><box size="0.20 0.018 0.002"/></geometry>
      <material name="matte_carbon"/>
    </visual>
    <!-- Navigation LED -->
    <visual>
      <origin xyz="0.16100 0.16100 0.008"/>
      <geometry><box size="0.012 0.012 0.006"/></geometry>
      <material name="led_cyan"/>
    </visual>
  </link>
  <joint name="joint_motor_1" type="fixed">
    <parent link="base_link"/>
    <child link="motor_1"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Motor 2 -->
  <link name="motor_2">
    <inertial>
      <mass value="1e-7"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <!-- CNC Aluminum Motor Stator -->
    <visual>
      <origin xyz="-0.14000 0.14000 0.012"/>
      <geometry><cylinder radius="0.020" length="0.015"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Prop Locknut -->
    <visual>
      <origin xyz="-0.14000 0.14000 0.024"/>
      <geometry><cylinder radius="0.007" length="0.009"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Aerodynamic Propeller Blur Disc -->
    <visual>
      <origin xyz="-0.14000 0.14000 0.027"/>
      <geometry><cylinder radius="0.10" length="0.003"/></geometry>
      <material name="prop_rear"/>
    </visual>
    <!-- Spinning Propeller Blades Silhouette -->
    <visual>
      <origin xyz="-0.14000 0.14000 0.028" rpy="0 0 2.3558"/>
      <geometry><box size="0.20 0.018 0.002"/></geometry>
      <material name="matte_carbon"/>
    </visual>
    <!-- Navigation LED -->
    <visual>
      <origin xyz="-0.16100 0.16100 0.008"/>
      <geometry><box size="0.012 0.012 0.006"/></geometry>
      <material name="led_red"/>
    </visual>
  </link>
  <joint name="joint_motor_2" type="fixed">
    <parent link="base_link"/>
    <child link="motor_2"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Motor 3 -->
  <link name="motor_3">
    <inertial>
      <mass value="1e-7"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <!-- CNC Aluminum Motor Stator -->
    <visual>
      <origin xyz="-0.14000 -0.14000 0.012"/>
      <geometry><cylinder radius="0.020" length="0.015"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Prop Locknut -->
    <visual>
      <origin xyz="-0.14000 -0.14000 0.024"/>
      <geometry><cylinder radius="0.007" length="0.009"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Aerodynamic Propeller Blur Disc -->
    <visual>
      <origin xyz="-0.14000 -0.14000 0.027"/>
      <geometry><cylinder radius="0.10" length="0.003"/></geometry>
      <material name="prop_rear"/>
    </visual>
    <!-- Spinning Propeller Blades Silhouette -->
    <visual>
      <origin xyz="-0.14000 -0.14000 0.028" rpy="0 0 3.9266"/>
      <geometry><box size="0.20 0.018 0.002"/></geometry>
      <material name="matte_carbon"/>
    </visual>
    <!-- Navigation LED -->
    <visual>
      <origin xyz="-0.16100 -0.16100 0.008"/>
      <geometry><box size="0.012 0.012 0.006"/></geometry>
      <material name="led_amber"/>
    </visual>
  </link>
  <joint name="joint_motor_3" type="fixed">
    <parent link="base_link"/>
    <child link="motor_3"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Motor 4 -->
  <link name="motor_4">
    <inertial>
      <mass value="1e-7"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <!-- CNC Aluminum Motor Stator -->
    <visual>
      <origin xyz="0.14000 -0.14000 0.012"/>
      <geometry><cylinder radius="0.020" length="0.015"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Prop Locknut -->
    <visual>
      <origin xyz="0.14000 -0.14000 0.024"/>
      <geometry><cylinder radius="0.007" length="0.009"/></geometry>
      <material name="cnc_aluminum"/>
    </visual>
    <!-- Aerodynamic Propeller Blur Disc -->
    <visual>
      <origin xyz="0.14000 -0.14000 0.027"/>
      <geometry><cylinder radius="0.10" length="0.003"/></geometry>
      <material name="prop_front"/>
    </visual>
    <!-- Spinning Propeller Blades Silhouette -->
    <visual>
      <origin xyz="0.14000 -0.14000 0.028" rpy="0 0 -0.7858"/>
      <geometry><box size="0.20 0.018 0.002"/></geometry>
      <material name="matte_carbon"/>
    </visual>
    <!-- Navigation LED -->
    <visual>
      <origin xyz="0.16100 -0.16100 0.008"/>
      <geometry><box size="0.012 0.012 0.006"/></geometry>
      <material name="led_green"/>
    </visual>
  </link>
  <joint name="joint_motor_4" type="fixed">
    <parent link="base_link"/>
    <child link="motor_4"/>
    <origin xyz="0 0 0"/>
  </joint>

</robot>
